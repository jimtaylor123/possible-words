APP_NAME="Possible Words"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8011

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Local queues require the jobs, failed_jobs, cache, and cache_locks migrations.
QUEUE_CONNECTION=database

# Local, Pusher-protocol-compatible WebSocket server. Start it with
# `composer run dev:realtime` (or `make realtime`). These credentials are only
# for local development; production continues to provide PUSHER_* variables.
REVERB_APP_ID=possiblewords-local
REVERB_APP_KEY=possiblewords-local-key
REVERB_APP_SECRET=possiblewords-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
PUSHER_PORT=443
PUSHER_SCHEME=https

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local Mailpit SMTP server. Start it with the command in README.md.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="notifications@possiblewords.jimtaylor.space"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=possiblewords
AWS_ENDPOINT=http://localhost:4566
AWS_URL=http://localhost:4566/possiblewords
AWS_USE_PATH_STYLE_ENDPOINT=true

OPENAI_API_KEY=

MERRIAM_WEBSTER_API_KEY=
FREE_DICTIONARY_ENABLED=true
MERRIAM_WEBSTER_ENABLED=false
DICTIONARY_THROTTLE=2

# .com availability checks (free Verisign RDAP, no API key)
DOMAIN_CHECK_ENABLED=true
DOMAIN_REQUEST_INTERVAL_MS=1000
DOMAIN_REQUEST_JITTER_MS=100
DOMAIN_RETRY_BASE_SECONDS=60
DOMAIN_RETRY_CAP_SECONDS=3600
DOMAIN_RETRY_JITTER_SECONDS=15
DOMAIN_MAX_RETRY_AFTER_SECONDS=600

# Public word releases (EventBridge schedule is UTC)
WORD_RELEASE_BATCH_SIZE=5
WORD_RELEASE_SCHEDULE="cron(0 */6 * * ? *)"
WORD_BATCH_SIZE=5
WORD_BATCH_SCHEDULE="cron(0 */6 * * ? *)"
WORD_BATCH_COORDINATOR_ITEMS=10
WORD_BATCH_COORDINATOR_SECONDS=600
WORD_BATCH_LEASE_TTL_SECONDS=720
WORD_BATCH_RETRY_BASE_SECONDS=60
WORD_BATCH_RETRY_CAP_SECONDS=3600
WORD_BATCH_STALE_SECONDS=21600

TTS_PROVIDER=edge-tts
EDGE_TTS_VOICE=en-GB-SoniaNeural

# Only needed if TTS_PROVIDER=openai:
TTS_VOICE=alloy
TTS_MODEL=tts-1

# AI-generated definitions (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Maximum 45 seconds; the queue job reserves 5 seconds for persistence and broadcasting.
DEFINITIONS_AI_TIMEOUT=45
DEFINITIONS_AI_RATE_LIMIT=10

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Google OAuth (Laravel Socialite) — create credentials in Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI must match exactly, e.g. http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
SCOUT_DRIVER=database
