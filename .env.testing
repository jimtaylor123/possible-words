# Environment for the Playwright end-to-end suite.
#
# This file is committed and must never contain a real secret. It is only ever
# used by `npm run test:e2e` against a throwaway SQLite file that gets recreated
# from .snapshots/dev-data.sqlite on every run.
#
# Why it exists: playwright.config.js starts the server with `--env=testing`.
# Without this file Laravel silently falls back to .env, and the E2E suite
# writes into the developer database.

APP_NAME=PossibleWords
APP_ENV=testing
# Fixed, throwaway key for a local test database. Not a secret — regenerate
# freely; nothing outside this file and database/testing.sqlite depends on it.
APP_KEY=base64:V/zoTlYXVZ9BWJ8Fo5sAsCF65KMa9pd4APfvjz8RHdw=
APP_DEBUG=true
APP_URL=http://localhost:8002

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# A file, not :memory: — `artisan serve` handles every request in a fresh PHP
# process, so an in-memory database would be empty on each one.
DB_DATABASE=database/testing.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=array

# .env.testing also governs the Pest suite, because phpunit.xml sets
# APP_ENV=testing. These must stay as in .env.example: DictionaryServiceTest
# fakes the free-dictionary API and asserts on it, so the flag has to be on.
FREE_DICTIONARY_ENABLED=true
MERRIAM_WEBSTER_ENABLED=false

TTS_PROVIDER=edge-tts
EDGE_TTS_VOICE=en-GB-SoniaNeural

VITE_APP_NAME="${APP_NAME}"

# Registers the /testing/login and /testing/logout routes the E2E specs use to
# authenticate without real OAuth credentials. Scoped to this file only.
E2E_AUTH_ENABLED=true

SCOUT_DRIVER=database